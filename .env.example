# ============================================================
# ARGOS - Environment Variables
# Salin file ini menjadi .env lalu isi nilai bertanda [WAJIB].
#   Windows : copy .env.example .env
#   Linux/Mac: cp .env.example .env
# (install.py melakukannya otomatis kalau .env belum ada)
# ============================================================

# ---------- Provider ----------
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai

# ---------- OpenAI ----------
# [WAJIB] https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Model (opsional, ini nilai default)
OPENAI_LLM_MODEL=gpt-5.4
OPENAI_VLM_MODEL=gpt-5-mini
OPENAI_VOICE_MODEL=gpt-4o-mini-tts
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_EXTRACTION_MODEL=gpt-5.4-mini
OPENAI_TITLE_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-5.4-mini
# Router hanya memilih sumber data (sql/vector) → model kecil sudah cukup
OPENAI_ROUTER_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_CHUNK_SIZE=400

# ---------- Google OAuth (login) ----------
# [WAJIB] Google Cloud Console > APIs & Services > Credentials > OAuth Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- JWT ----------
# [WAJIB] string acak panjang:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ---------- CORS ----------
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# ---------- Docling (PDF parsing) ----------
# auto = GPU kalau ada, kalau tidak CPU | cuda | cpu | mps (Apple Silicon)
DOCLING_DEVICE=auto
DOCLING_NUM_THREADS=4
# OCR hanya untuk PDF hasil scan. Gambar sudah dibaca OpenAI Vision. (true = lebih lambat)
DOCLING_OCR=false

# ---------- Penyimpanan ----------
# Kosong = folder root project. Di Docker sudah diatur ke /app/data.
SQLITE_PATH=
CHROMA_PATH=

# Belum dipakai kode (aplikasi memakai SQLite)
DATABASE_URL=
