# ============================================================
# ARGOS - Environment Variables (HANYA rahasia & keamanan)
# Salin file ini menjadi .env lalu isi SEMUA nilai di bawah.
#   Windows : copy .env.example .env
#   Linux/Mac: cp .env.example .env
#
# Pengaturan lain (model, timeout, batas upload, Docling, JWT expiry)
# ada di app/core/config.py, BUKAN di file ini.
# Aplikasi gagal start jika salah satu nilai di bawah kosong.
# ============================================================

# ---------- OpenAI ----------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---------- Google OAuth (login) ----------
# Google Cloud Console > APIs & Services > Credentials > OAuth Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- JWT / session ----------
# string acak panjang:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# ---------- Kebijakan akses ----------
# Hanya akun Google Workspace dengan domain ini yang boleh login.
# Isi gmail.com untuk mengizinkan semua akun Gmail pribadi (testing/portofolio).
ALLOWED_GOOGLE_DOMAIN=perusahaan.com
# Satu-satunya admin aplikasi.
ADMIN_EMAIL=admin@perusahaan.com
# Origin frontend yang diizinkan (CORS), pisahkan dengan koma.
ALLOWED_ORIGINS=http://localhost:8000
