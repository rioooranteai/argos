# ============================================================
# ARGOS - Environment Variables (ONLY secrets & security policy)
# Copy this file to .env and fill in ALL the values below.
#   Windows : copy .env.example .env
#   Linux/Mac: cp .env.example .env
#
# Every other setting (models, timeouts, upload limits, Docling, JWT expiry)
# lives in app/core/config.py, NOT in this file.
# The app refuses to start if any value below is empty.
# ============================================================

# ---------- OpenAI ----------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---------- Google OAuth (login) ----------
# Google Cloud Console > APIs & Services > Credentials > OAuth Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- JWT / session ----------
# a long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# ---------- Access policy ----------
# Only Google Workspace accounts of this domain may sign in.
# Set gmail.com to allow every personal Gmail account (testing/portfolio).
ALLOWED_GOOGLE_DOMAIN=company.com
# The app's only admin.
ADMIN_EMAIL=admin@company.com
# Allowed frontend origins (CORS), comma-separated.
ALLOWED_ORIGINS=http://localhost:8000

# ---------- Observability (optional) ----------
# Langfuse project keys (Langfuse → Settings → API keys). Leave empty to turn tracing off.
# Endpoint, region, sampling and model prices: app/core/telemetry/config.py
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
