# Secrets — never in the image (env comes in through env_file at runtime)
.env
.env.*
!.env.example

# Virtual environment (this project folder is also a venv)
Lib/
Scripts/
Include/
include/
share/
pyvenv.cfg
.venv/
venv/
env/

# Runtime data (mounted as a volume)
data/
*.db
*.db-shm
*.db-wal
chroma_db/
chroma_data/
temp_uploads/

# Git, IDE, cache, test
.git/
.github/
.idea/
.vscode/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
tests/
*.log
